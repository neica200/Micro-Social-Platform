@model List<Micro_social_app.Models.Profile>

@{
    ViewData["Title"] = "Search results";
}

<h3 class="mb-4">
    Results for "<strong>@ViewBag.Query</strong>"
</h3>

@if (!Model.Any())
{
    <div class="alert alert-info">No users found.</div>
}
else
{
    <div class="list-group">
        @foreach (var p in Model)
        {
            <a class="list-group-item list-group-item-action d-flex align-items-center"
               asp-controller="Profiles"
               asp-action="Index"
               asp-route-id="@p.UserId">

                <img src="@(string.IsNullOrEmpty(p.ProfileImageUrl)
                                         ? "https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_1280.png"
                                         : p.ProfileImageUrl)"
             class="rounded-circle me-3"
             style="width:50px;height:50px;object-fit:cover;" />

                <div>
                    <strong>@(p.FullName ?? p.User.UserName)</strong>
                    <div class="text-muted">
                        @@@p.User.UserName
                @if (p.IsPrivate)
                        {
                            <span class="ms-2">🔒</span>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
}
