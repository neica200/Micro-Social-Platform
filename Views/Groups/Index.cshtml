@{
    ViewBag.Title = "Groups";
}

<h2 class="mb-3">Groups</h2>

@if (ViewBag.Message != null)
{
    <div class="alert @ViewBag.Alert">@ViewBag.Message</div>
}

<div class="mb-3">
    <a asp-action="New" class="btn btn-primary">Create new group</a>
    <a asp-action="Deleted" class="btn btn-outline-secondary ms-2">My deleted groups</a>
</div>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#mygroups">
            My Groups
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#membergroups">
            Groups I’m In
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#explore">
            Explore Groups
        </button>
    </li>
</ul>

<div class="tab-content">

    <!--MY GROUPS -->
    <div class="tab-pane fade show active" id="mygroups">
        @if (ViewBag.MyGroups.Count == 0)
        {
            <p>You haven’t created any groups yet.</p>
        }
        else
        {
            <div class="row">
                @foreach (var g in ViewBag.MyGroups)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card border-primary h-100">
                            <div class="card-body">
                                <h5>@g.Name</h5>
                                <p>@g.Description</p>
                                <span class="badge bg-primary">Moderator</span>
                            </div>
                            <div class="card-footer bg-white">
                                <a asp-action="Show" asp-route-id="@g.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- GROUPS I'M IN ->
    <div class="tab-pane fade" id="membergroups">
        @if (ViewBag.MemberGroups.Count == 0)
        {
            <p>You are not a member of any group.</p>
        }
        else
        {
            <div class="row">
                @foreach (var g in ViewBag.MemberGroups)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5>@g.Name</h5>
                                <p>@g.Description</p>
                                <p class="text-muted small">
                                    Moderator: @g.Moderator.UserName
                                </p>
                                <span class="badge bg-success">Member</span>
                            </div>
                            <div class="card-footer bg-white">
                                <a asp-action="Show" asp-route-id="@g.Id"
                                   class="btn btn-sm btn-outline-success">
                                    View
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- EXPLORE -->
    <div class="tab-pane fade" id="explore">
        @if (ViewBag.ExploreGroups.Count == 0)
        {
            <p>No new groups to explore.</p>
        }
        else
        {
            <div class="row">
                @foreach (var g in ViewBag.ExploreGroups)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5>@g.Name</h5>
                                <p>@g.Description</p>
                                <p class="text-muted small">
                                    Created by @g.Moderator.UserName
                                </p>
                            </div>
                            <div class="card-footer bg-white">
                                <a asp-action="Show" asp-route-id="@g.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>
