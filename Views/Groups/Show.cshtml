@model Micro_social_app.Models.Group

@{
    ViewBag.Title = "Group details";
}

<div class="container mt-4">

    <!-- GROUP HEADER -->
    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h2 class="mb-1">@Model.Name</h2>
                <p class="text-muted mb-0">
                    Created by <strong>@Model.Moderator?.UserName</strong>
                </p>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Back</a>

                @if (ViewBag.IsModerator == true)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        Edit
                    </a>
                }

                @if (ViewBag.IsModerator == true || ViewBag.IsAdmin == true)
                {
                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">
                        <button class="btn btn-danger">Delete</button>
                    </form>
                }
            </div>
        </div>

        <div class="card-body pt-0">
            <p class="mb-0">@Model.Description</p>
        </div>
    </div>

    @{
        var isApproved = (bool)(ViewBag.IsMemberApproved ?? false);
        var isMod = (bool)(ViewBag.IsModerator ?? false);
        var currUser = ViewBag.CurrUser as string;
        var messages = ViewBag.Messages as IEnumerable<GroupMessage> ?? Enumerable.Empty<GroupMessage>();
    }

    <div class="mt-4">
        <h4 class="mb-3">Messages</h4>

        @if (isApproved || isMod)
        {
            <form method="post" asp-controller="GroupMessages" asp-action="New" class="mb-4">
                <input type="hidden" name="groupId" value="@Model.Id" />

                <div class="input-group">
                    <input name="content" class="form-control" maxlength="2000"
                           placeholder="Write a message..." />
                    <button class="btn btn-primary" type="submit">Send</button>
                </div>
            </form>
        }
        else if ((bool)(ViewBag.HasPendingRequest ?? false))
        {
            <div class="alert alert-info">Your join request is pending. You can post after approval.</div>
        }
        else
        {
            <div class="alert alert-warning">Join this group to post messages.</div>
        }

        @if (!messages.Any())
        {
            <div class="text-muted">No messages yet.</div>
        }
        else
        {
            <div class="list-group">
                @foreach (var m in messages)
                {
                    var authorName = m.User?.UserName ?? "User";
                    var isMine = (m.UserId == currUser);

                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">@authorName</div>
                                <div class="text-muted small">
                                    @m.CreatedAt.ToLocalTime().ToString("g")
                                    @if (m.UpdatedAt != null)
                                    {
                                        <span> • edited</span>
                                    }
                                </div>
                            </div>

                            @if (isMine)
                            {
                                <div class="d-flex gap-2">
                                    <!-- Edit inline: simplu (fără modal) -->
                                    <form method="post" asp-controller="GroupMessages" asp-action="Edit" class="d-flex gap-2">
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <input name="content" class="form-control form-control-sm" value="@m.Content" maxlength="2000" />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">Save</button>
                                    </form>

                                    <form method="post" asp-controller="GroupMessages" asp-action="Delete">
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                    </form>
                                </div>
                            }
                        </div>

                        @if (!isMine)
                        {
                            <div class="mt-2">@m.Content</div>
                        }
                    </div>
                }
               
            </div>
        }
    </div>
    <div class="text-muted">Messages count: @messages.Count()</div>

    <!-- JOIN / LEAVE / STATUS -->
    <div class="mb-4">
        <div class="d-flex flex-wrap align-items-center gap-2">

            @* APPROVED MEMBER *@
            @if (ViewBag.IsMemberApproved == true)
            {
                <span class="badge bg-success">Member</span>

                @* MODERATOR *@
                @if (ViewBag.IsModerator == true)
                {
                    <span class="badge bg-primary">Moderator</span>
                }
                else
                {
                    @* LEAVE GROUP *@
                    <form asp-action="Leave"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">
                        <button type="submit"
                                class="btn btn-outline-danger">
                            Leave group
                        </button>
                    </form>
                }
            }
            @* PENDING *@
            else if (ViewBag.HasPendingRequest == true)
            {
                <span class="badge bg-warning text-dark">
                    Join request pending
                </span>
            }
            @* NOT MEMBER *@
            else
            {
                <form asp-action="Join"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline">
                    <button type="submit" class="btn btn-outline-primary">
                        Join group
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="row g-3">

        <!-- PENDING REQUESTS (MODERATOR ONLY) -->
        @if (ViewBag.IsModerator == true)
        {
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h4 class="mb-3">Pending requests</h4>

                        @if (ViewBag.PendingRequests != null && ViewBag.PendingRequests.Count > 0)
                        {
                            <ul class="list-group">
                                @foreach (var m in ViewBag.PendingRequests)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@m.User?.UserName</span>

                                        <div class="d-flex gap-2">
                                            <form asp-action="Approve" method="post">
                                                <input type="hidden" name="groupId" value="@Model.Id" />
                                                <input type="hidden" name="userId" value="@m.UserId" />
                                                <button class="btn btn-sm btn-success">Approve</button>
                                            </form>

                                            <form asp-action="Reject" method="post">
                                                <input type="hidden" name="groupId" value="@Model.Id" />
                                                <input type="hidden" name="userId" value="@m.UserId" />
                                                <button class="btn btn-sm btn-danger">Reject</button>
                                            </form>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No pending requests.</p>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- MEMBERS + KICK -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="mb-3">Members</h4>

                    @{
                        var approvedMembers = Model.GroupMembers
                        .Where(m => m.IsDeleted == false && m.Status == "Approved")
                        .ToList();
                    }

                    @if (approvedMembers.Count == 0)
                    {
                        <p class="text-muted mb-0">No members yet.</p>
                    }
                    else
                    {
                        <ul class="list-group">
                            @foreach (var m in approvedMembers)
                            {
                                bool isGroupModerator =
                                (m.UserId == Model.ModeratorId) ||
                                (m.Role == "Moderator");

                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@m.User?.UserName</strong>
                                        @if (isGroupModerator)
                                        {
                                            <span class="badge bg-primary ms-2">Moderator</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success ms-2">Member</span>
                                        }
                                    </div>

                                    @* KICK *@
                                    @if (ViewBag.IsModerator == true && !isGroupModerator)
                                    {
                                        <form asp-action="Kick"
                                              method="post"
                                              class="d-inline">
                                            <input type="hidden" name="groupId" value="@Model.Id" />
                                            <input type="hidden" name="userId" value="@m.UserId" />
                                            <button class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Remove this user from the group?');">
                                                Kick
                                            </button>
                                        </form>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

    </div>
</div>
