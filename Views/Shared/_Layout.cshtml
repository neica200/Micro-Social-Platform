<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Micro_social_app</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Micro_social_app.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>
<body>

    <!-- NAVBAR CUSTOM -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom shadow-sm">
            <div class="container-fluid">

                <!-- BRAND -->
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-chat-dots-fill"></i>
                    MicroSocial
                </a>

                <!-- TOGGLER -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <!-- SEARCH -->
                        <form class="d-flex mx-auto position-relative"
                              method="get"
                              asp-controller="Search"
                              asp-action="Users"
                              style="width: 420px;">

                            <input id="liveSearchInput"
                                   class="form-control rounded-pill ps-4"
                                   type="search"
                                   name="q"
                                   placeholder="     Search users..."
                                   autocomplete="off" />

                            <i class="bi bi-search position-absolute text-muted"
                               style="left: 15px; top: 50%; transform: translateY(-50%);"></i>

                            <div id="liveSearchResults"
                                 class="list-group position-absolute w-100 mt-2"
                                 style="top: 100%; z-index: 9999; display: none;">
                            </div>
                        </form>
          


                    <!-- RIGHT MENU -->
                    <ul class="navbar-nav ms-auto align-items-center gap-2">

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="AdminUsers" asp-action="Index">Users</a>
                            </li>
                        }

                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- Follow Requests -->
                            <li class="nav-item">
                                <a class="nav-link position-relative"
                                   asp-controller="Follows"
                                   asp-action="Requests"
                                   title="Follow Requests">
                                    <i class="bi bi-person-plus fs-5"></i>
                                    @await Component.InvokeAsync("FollowRequestsBadge")
                                </a>
                            </li>


                            <!-- Profile dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                    <img src="https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_1280.png"
                                         class="rounded-circle"
                                         style="width:32px;height:32px;object-fit:cover;" />

                                    <span class="d-none d-lg-inline">
                                        @User.Identity.Name
                                    </span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Profiles"
                                           asp-action="Index">
                                            <i class="bi bi-person me-2"></i>
                                            My Profile
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Posts"
                                           asp-action="New">
                                            <i class="bi bi-plus-square me-2"></i>
                                            New Post
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <form asp-area="Identity"
                                              asp-page="/Account/Logout"
                                              method="post">
                                            <button class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>
                                                Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- GUEST -->
                            <li class="nav-item">
                                <a class="btn btn-outline-light rounded-pill px-3"
                                   asp-area="Identity"
                                   asp-page="/Account/Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-light rounded-pill px-3 fw-semibold"
                                   asp-area="Identity"
                                   asp-page="/Account/Register">
                                    Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <!--mesaje -->
        <div class="container mt-3">
            <div id="flash"
                 class="alert d-none alert-dismissible fade show shadow-sm"
                 role="alert">
                <span id="flash-text"></span>
                <button type="button" class="btn-close" aria-label="Close"></button>
            </div>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["message"] != null)
            {
                var t = TempData["messageType"]?.ToString() ?? "alert-info";
                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        showFlash("@TempData["message"]", "@t");
                    });
                </script>
            }


            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Micro_social_app - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/js/live-search.js" asp-append-version="true"></script>



    <!--SCRIPT PT AJAX-->
    <script>
        let flashTimer = null;

              function showFlash(message, type) {
            const box = document.getElementById("flash");
            const text = document.getElementById("flash-text");
            if (!box || !text) return;

            // curăț doar culorile vechi
            box.classList.remove(
                "d-none",
                "alert-success",
                "alert-danger",
                "alert-info"
            );

            // 1️ dacă vine direct din TempData: "alert-success"
            if (typeof type === "string" && type.startsWith("alert-")) {
                box.classList.add(type);
            }
            // 2️ dacă vine "success" / "danger" din JS
            else if (type === "success") {
                box.classList.add("alert-success");
            }
            else if (type === "danger") {
                box.classList.add("alert-danger");
            }
            else if (type === "warning") {
                box.classList.add("alert-warning");
            }
            // 3️ fallback
            else {
                box.classList.add("alert-info");
            }

            text.textContent = message;

            const closeBtn = box.querySelector(".btn-close");
            if (closeBtn) {
                closeBtn.onclick = () => box.classList.add("d-none");
            }

            box.classList.remove("d-none");

            if (flashTimer) clearTimeout(flashTimer);
            flashTimer = setTimeout(() => {
                box.classList.add("d-none");
            }, 3000);
        }
        async function toggleLike(postId, btn) {
            const icon = btn.querySelector('i');
            const likesSpan = document.getElementById(`likes-${postId}`);

            const wasLiked = btn.classList.contains('ig-liked');
            let oldLikes = null;

            if (likesSpan) {
                oldLikes = parseInt(likesSpan.textContent, 10);
                if (isNaN(oldLikes)) oldLikes = null;
            }

            // 1) Optimistic UI
            if (wasLiked) {
                btn.classList.remove('ig-liked');
                if (icon) {
                    icon.classList.remove('bi-heart-fill');
                    icon.classList.add('bi-heart');
                }
                if (likesSpan && oldLikes !== null)
                    likesSpan.textContent = Math.max(0, oldLikes - 1);
            } else {
                btn.classList.add('ig-liked');
                if (icon) {
                    icon.classList.remove('bi-heart');
                    icon.classList.add('bi-heart-fill');
                }
                if (likesSpan && oldLikes !== null)
                    likesSpan.textContent = oldLikes + 1;
            }

            // 2) Request la server
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const formData = new URLSearchParams();
            formData.append('postId', postId);

            try {
                const response = await fetch('/Reactions/ToggleLikeAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'RequestVerificationToken': token
                    },
                    body: formData.toString()
                });

                // cazul tău: redirect la Login
                if (response.redirected && response.url.includes("Login")) {
                    showFlash("You must be logged in to like.", "warning");
                    throw new Error("Redirected to login");
                }

                if (response.status === 403) {
                    showFlash("You don't have permission to like.", "danger");
                    throw new Error("Forbidden");
                }

                if (!response.ok) {
                    showFlash("Something went wrong. Please try again.", "danger");
                    throw new Error('Request failed: ' + response.status);
                }

                // dacă serverul întoarce HTML în loc de JSON
                const contentType = response.headers.get("content-type") || "";
                if (!contentType.includes("application/json")) {
                    showFlash("You must be logged in to like.", "warning");
                    throw new Error("Not JSON response");
                }

                const data = await response.json();

                // 3) Sync cu serverul
                if (data.liked) {
                    btn.classList.add('ig-liked');
                    if (icon) {
                        icon.classList.remove('bi-heart');
                        icon.classList.add('bi-heart-fill');
                    }
                } else {
                    btn.classList.remove('ig-liked');
                    if (icon) {
                        icon.classList.remove('bi-heart-fill');
                        icon.classList.add('bi-heart');
                    }
                }

                if (likesSpan) {
                    likesSpan.textContent = data.likes;
                }

            } catch (err) {
                // 4) Rollback
                if (wasLiked) {
                    btn.classList.add('ig-liked');
                    if (icon) {
                        icon.classList.remove('bi-heart');
                        icon.classList.add('bi-heart-fill');
                    }
                } else {
                    btn.classList.remove('ig-liked');
                    if (icon) {
                        icon.classList.remove('bi-heart-fill');
                        icon.classList.add('bi-heart');
                    }
                }

                if (likesSpan && oldLikes !== null) {
                    likesSpan.textContent = oldLikes;
                }

                console.error('Like failed:', err);
            }
        }

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.js-like-btn');
            if (!btn) return;

            const postId = btn.getAttribute('data-postid');
            if (!postId) return;

            toggleLike(postId, btn);
        });
    </script>



    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

