@model Micro_social_app.Models.ViewModels.FeedPageVM

<div class="card mb-3 shadow-sm">
    <div class="card-header bg-white fw-bold py-2" style="font-size:0.95rem;">
        Suggested profiles
    </div>

    <div class="list-group list-group-flush">
        @foreach (var p in Model.SuggestedProfiles)
        {
            var name = p.FullName ?? p.User?.UserName ?? "User";

            <div class="list-group-item py-2 px-2 d-flex justify-content-between align-items-center">
                <a asp-controller="Profiles" asp-action="Index" asp-route-id="@p.UserId"
                   class="text-decoration-none text-dark d-flex align-items-center gap-2">
                    <img src="@p.ProfileImageUrl" class="rounded-circle"
                         style="width:32px;height:32px;object-fit:cover;" />
                    <div style="line-height:1.1">
                        <div class="fw-bold" style="font-size:0.9rem;">@name</div>
                        <div class="text-muted" style="font-size:0.75rem;">@(p.IsPrivate ? "Private" : "Public")</div>
                    </div>
                </a>

                @if (Model.CurrUserId != null)
                {
                    <form asp-controller="Follows" asp-action="Follow" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@p.UserId" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button class="btn btn-sm btn-outline-primary px-2" style="font-size:0.8rem;">Follow</button>
                    </form>
                }
            </div>
        }
    </div>
</div>


<div class="card shadow-sm">
    <div class="card-header bg-white fw-bold">Suggested groups</div>
    <div class="list-group list-group-flush">
        @foreach (var g in Model.SuggestedGroups)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
               asp-controller="Groups" asp-action="Show" asp-route-id="@g.Id">
                <span class="fw-bold">@g.Name</span>
                <span class="text-muted" style="font-size:0.8rem;">View</span>
            </a>
        }
    </div>
    <div class="card-footer bg-white">
        <a asp-controller="Groups" asp-action="Index" class="text-decoration-none">See all groups →</a>
    </div>
</div>
