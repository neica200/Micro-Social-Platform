@model Micro_social_app.Models.Profile

@{
    ViewData["Title"] = Model.FullName;
}

<div class="container mt-4" style="max-width: 935px;">

    <div class="row align-items-center mb-5">
        <div class="col-md-4 text-center">
            <img src="@(string.IsNullOrEmpty(Model.ProfileImageUrl) ? "https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_1280.png" : Model.ProfileImageUrl)"
                 class="rounded-circle img-thumbnail"
                 style="width: 160px; height: 160px; object-fit: cover;">
        </div>

        <div class="col-md-8">
            <div class="d-flex align-items-center mb-3">
                <h3 class="me-4 fw-light">@Model.FullName</h3>

                @if (ViewBag.IsMe)
                {
                    <a asp-action="Edit" class="btn btn-outline-secondary btn-sm fw-bold px-3">Edit Profile</a>

                    <a asp-controller="Posts" asp-action="New" class="btn btn-primary btn-sm fw-bold px-3 ms-2">
                        ➕ New Post
                    </a>
                }
                else
                {
                    <button class="btn btn-primary btn-sm fw-bold px-3 ms-2">Follow</button>
                    <button class="btn btn-outline-secondary btn-sm fw-bold px-3 ms-2">Message</button>
                }
            </div>

            <div class="d-flex mb-3">
                <div class="me-4">
                    <strong>@(ViewBag.CanSeePosts == true ? ((ViewBag.Posts as IEnumerable<dynamic>)?.Count() ?? 0) : 0)</strong> posts
                </div>
                <div class="me-4"><strong>0</strong> followers</div>
                <div class="me-4"><strong>0</strong> following</div>
            </div>

            <div>
                <p class="mb-0 text-break" style="white-space: pre-wrap;">@Model.Description</p>
                @if (Model.IsPrivate)
                {
                   //
                }
            </div>
        </div>
    </div>

    @if (ViewBag.CanSeePosts != true)
    {
        <div class="alert alert-info text-center">
            🔒 This profile is private.
        </div>
    }
    else
    {
        <ul class="nav nav-tabs justify-content-center mb-4 border-top" id="profileTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active border-0 text-dark fw-bold" id="grid-tab" data-bs-toggle="tab" data-bs-target="#grid-content" type="button">
                    🖼️ POSTS
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link border-0 text-dark fw-bold" id="feed-tab" data-bs-toggle="tab" data-bs-target="#feed-content" type="button">
                    📝 LIST
                </button>
            </li>
        </ul>

        <div class="tab-content" id="profileTabsContent">

            <div class="tab-pane fade show active" id="grid-content">
                <div class="row g-4">
                    @if (ViewBag.Posts != null)
                    {
                        @foreach (var post in ViewBag.Posts)
                        {

                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                            {
                                <div class="col-4">
                                    <a asp-controller="Posts" asp-action="Show" asp-route-id="@post.Id" class="text-decoration-none">
                                        <div class="ratio ratio-1x1 bg-light border position-relative">
                                            <img src="@post.ImageUrl" class="img-fluid" style="object-fit: cover;" />
                                        </div>
                                    </a>
                                </div>
                            }
                        }
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="feed-content">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8 col-lg-6">

                        @foreach (var post in (IEnumerable<Micro_social_app.Models.Post>)ViewBag.Posts)
                        {
                            string fullName =
                            post.User?.Profile?.FullName
                            ?? post.User?.UserName
                            ?? "User";

                            string profileImg = post.User?.Profile?.ProfileImageUrl ?? "";
                            string initial = !string.IsNullOrEmpty(fullName)
                            ? fullName.Substring(0, 1).ToUpper()
                            : "U";

                            int commentsCount = post.Comments?.Count ?? 0;
                            int reactionsCount = post.Reactions?.Count ?? 0;

                            string currUserId = ViewBag.CurrUser as string;
                            bool isLikedByMe = false;

                            if (post.Reactions != null && !string.IsNullOrEmpty(currUserId))
                            {
                                foreach (var r in post.Reactions)
                                {
                                    if (r.Type == "Like" && r.UserId == currUserId)
                                    {
                                        isLikedByMe = true;
                                        break;
                                    }
                                }
                            }

                            <div class="card mb-4 shadow-sm">

                                <!-- HEADER -->
                                <div class="card-header bg-white d-flex align-items-center gap-2">

                                    <a asp-controller="Profiles"
                                       asp-action="Index"
                                       asp-route-id="@post.UserId"
                                       class="text-decoration-none">

                                        @if (!string.IsNullOrEmpty(profileImg))
                                        {
                                            <img src="@profileImg"
                                                 class="rounded-circle"
                                                 style="width:40px;height:40px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                                                 style="width:40px;height:40px;">
                                                @initial
                                            </div>
                                        }
                                    </a>

                                    <div>
                                        <a asp-controller="Profiles"
                                           asp-action="Index"
                                           asp-route-id="@post.UserId"
                                           class="fw-bold text-dark text-decoration-none">
                                            @fullName
                                        </a>

                                        <div class="text-muted" style="font-size:0.8rem;">
                                            @post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                        </div>
                                    </div>

                                </div>

                                
                                @if (!string.IsNullOrEmpty(post.ImageUrl))
                                {
                                    <img src="@post.ImageUrl" class="w-100" />
                                }
                                else if (!string.IsNullOrEmpty(post.VideoUrl))
                                {
                                    <video class="w-100" controls>
                                        <source src="@post.VideoUrl" />
                                    </video>
                                }

                                
                                <div class="card-body">

                                    
                                    <div class="ig-actions-row">
                                        <button type="button"
                                                class="ig-icon-btn js-like-btn @(isLikedByMe ? "ig-liked" : "")"
                                                data-postid="@post.Id"
                                                title="Like">
                                            <i class="bi @(isLikedByMe ? "bi-heart-fill" : "bi-heart")"></i>
                                        </button>

                                        <a asp-controller="Posts"
                                           asp-action="Show"
                                           asp-route-id="@post.Id"
                                           class="ig-icon-btn ig-icon-link"
                                           title="Comment">
                                            <i class="bi bi-chat"></i>
                                        </a>

                                        <button type="button"
                                                class="ig-icon-btn ms-auto"
                                                title="Share">
                                            <i class="bi bi-send"></i>
                                        </button>
                                    </div>

                                    
                                    <div class="ig-likes">
                                        <span id="likes-@post.Id">@reactionsCount</span> likes
                                    </div>

                                   
                                    @if (!string.IsNullOrEmpty(post.Content))
                                    {
                                        <div class="ig-caption">
                                            <span class="ig-caption-user"><b>@fullName</b></span>
                                            <span class="ig-caption-text">@post.Content</span>
                                        </div>
                                    }

                                    
                                    <a asp-controller="Posts"
                                       asp-action="Show"
                                       asp-route-id="@post.Id"
                                       class="ig-view-comments">
                                        @(commentsCount > 0 ? $"View all {commentsCount} comments" : "Add a comment…")
                                    </a>

                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>
    }
</div>
