@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="container py-5" style="max-width: 980px;">
    <div class="row g-4 align-items-stretch">
        <!-- Left: branding -->
        <div class="col-lg-6 d-none d-lg-block">
            <div class="h-100 p-5 rounded-4 bg-dark text-white shadow-sm">
                <h1 class="fw-bold mb-3">MicroSocial</h1>
                <p class="text-white-50 mb-4">
                    Log in to see posts, reactions, and profiles. Quickly search for users using the top bar and visit their profiles.

                </p>

                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-white text-dark rounded-circle d-flex align-items-center justify-content-center"
                         style="width:44px;height:44px;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <div class="fw-semibold">Explore profiles</div>
                        <div class="text-white-50 small">
                            Public or private (private posts are protected).
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white text-dark rounded-circle d-flex align-items-center justify-content-center"
                         style="width:44px;height:44px;">
                        <i class="bi bi-search"></i>
                    </div>
                    <div>
                        <div class="fw-semibold">Search + Live Search</div>
                        <div class="text-white-50 small">Instant find users from navbar</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: login form -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h2 class="fw-bold mb-1">Welcome back</h2>
                    <p class="text-muted mb-4">Login in your account</p>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Password</label>
                            <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="current-password" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label class="form-check-label" asp-for="Input.RememberMe">Remember me</label>
                            </div>

                            <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none">
                                Forgot password?
                            </a>
                        </div>

                        <button id="login-submit" type="submit" class="btn btn-dark btn-lg w-100">
                            Login
                        </button>

                        <div class="text-center mt-3">
                            <span class="text-muted">Not having an account?</span>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-semibold">
                                Register
                            </a>
                        </div>

                        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                        {
                            <hr class="my-4" />

                            <div class="text-center text-muted mb-3">Or continue with</div>

                            <div class="d-grid gap-2">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit"
                                            class="btn btn-outline-dark btn-lg"
                                            name="provider"
                                            value="@provider.Name"
                                            title="Log in using your @provider.DisplayName account"
                                            formmethod="post"
                                            formaction="./ExternalLogin?returnUrl=@Model.ReturnUrl">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>
                                        @provider.DisplayName
                                    </button>
                                }
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
